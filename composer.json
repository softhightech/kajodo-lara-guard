{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kajodo/laravel-guard",
    "description": "Laravel middleware to allow or block visitors based on the Kajodo IP-intelligence decision.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/softhightech/kajodo-lara-guard",
    "authors": [
        {
            "name": "Brahim Moullablad",
            "email": "contact@softhightech.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kajodo\\Guard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kajodo\\Guard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kajodo\\Guard\\KajodoGuardServiceProvider"
            ],
            "aliases": {
                "KajodoGuard": "Kajodo\\Guard\\Facades\\KajodoGuard"
            }
        }
    },
    "minimum-stability": "stable"
}
